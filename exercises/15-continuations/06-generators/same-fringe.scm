(define (make-generator tree)
  (define return #f)
  (define (walk t)
    (if (pair? t)
        (begin (walk (car t)) (walk (cdr t)))
        (if (eq? t '())
            #f
            (call/cc (lambda (resume)
                       (set! continue resume)
                       (return t))))))
  (define continue (lambda (ignored) (walk tree) (return 'done)))
  (lambda ()
    (call/cc (lambda (r) (set! return r) (continue #f)))))
(define (same-fringe? t1 t2)
  (define g1 (make-generator t1))
  (define g2 (make-generator t2))
  (define (loop)
    (define a (g1))
    (define b (g2))
    (if (eq? a b)
        (if (eq? a 'done) #t (loop))
        #f))
  (loop))
(same-fringe? '(a (b c)) '((a b) c))
(same-fringe? '(a (b c)) '((a b) d))
(same-fringe? '(a b) '(a b c))
