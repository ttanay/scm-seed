(define (list . xs) xs)
(define fail-stack '())
(define (fail)
  ((lambda (k) (set! fail-stack (cdr fail-stack)) (k #f)) (car fail-stack)))
(define (amb choices)
  (call/cc
    (lambda (k)
      (define (try cs)
        (if (pair? cs)
            (begin
              (call/cc (lambda (next)
                         (set! fail-stack (cons next fail-stack))
                         (k (car cs))))
              (try (cdr cs)))
            (fail)))
      (try choices))))
(define (range a b) (if (< b a) '() (cons a (range (+ a 1) b))))
(define (solve-all)
  (define results '())
  (define (search)
    (define a (amb (range 1 20)))
    (define b (amb (range 1 20)))
    (define c (amb (range 1 20)))
    (if (< a b)
        (if (= (+ (* a a) (* b b)) (* c c))
            (set! results (cons (list a b c) results))))
    (fail))
  (call/cc (lambda (done) (set! fail-stack (cons done '())) (search)))
  results)
(solve-all)
