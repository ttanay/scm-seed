(define (write-all cs) (if (pair? cs) (begin (write-char (car cs)) (write-all (cdr cs)))))
(define (write-string s) (write-all (string->list s)))
(define (read-word)
  (define c (read-char))
  (if (eof-object? c) '()
      (if (< (char->integer c) 33) '()
          (cons c (read-word)))))
(define w1 (string->symbol (list->string (read-word))))
(define w2 (string->symbol (list->string (read-word))))
(if (eq? w1 'apple) (write-string "apple ") (write-string "? "))
(if (eq? w2 'banana) (write-string "banana") (write-string (symbol->string w2)))
(write-char #\newline)
