(define (digit d) (write-char (integer->char (+ 48 d))))
(define (write-int n)
  (if (< n 0)
      (begin (write-char #\-) (write-int (- 0 n)))
      (if (< n 10) (digit n) (begin (write-int (quotient n 10)) (digit (remainder n 10))))))
(define (digit? c) (if (char? c) (if (< 47 (char->integer c)) (< (char->integer c) 58) #f) #f))
(define (minus? c) (if (char? c) (= (char->integer c) 45) #f))
(define (read-digits acc)
  (if (digit? (peek-char))
      (read-digits (+ (* acc 10) (- (char->integer (read-char)) 48)))
      acc))
(define (sum total)
  (define c (peek-char))
  (if (eof-object? c)
      total
      (if (digit? c)
          (sum (+ total (read-digits 0)))
          (if (minus? c)
              (begin (read-char) (sum (- total (read-digits 0))))
              (begin (read-char) (sum total))))))
(write-int (sum 0))
(write-char #\newline)
