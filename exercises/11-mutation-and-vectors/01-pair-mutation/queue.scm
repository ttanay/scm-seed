(define (make-queue) (cons '() '()))
(define (enqueue! q x)
  (define cell (cons x '()))
  (if (pair? (car q)) (set-cdr! (cdr q) cell) (set-car! q cell))
  (set-cdr! q cell))
(define (dequeue! q)
  (define x (car (car q)))
  (set-car! q (cdr (car q)))
  x)
(define q (make-queue))
(enqueue! q 'a)
(enqueue! q 'b)
(enqueue! q 'c)
(dequeue! q)
(enqueue! q 'd)
(car q)
