(define n 50)
(define composite (make-vector (+ n 1) #f))
(define (mark! i step)
  (if (< i (+ n 1)) (begin (vector-set! composite i #t) (mark! (+ i step) step))))
(define (primes i)
  (if (< n i)
      '()
      (if (vector-ref composite i)
          (primes (+ i 1))
          (begin (mark! (* i i) i) (cons i (primes (+ i 1)))))))
(primes 2)
