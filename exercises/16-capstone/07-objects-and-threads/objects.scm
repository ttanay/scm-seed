(define (make-account balance)
  (define (withdraw amount)
    (if (< balance amount)
        'insufficient-funds
        (begin (set! balance (- balance amount)) balance)))
  (define (deposit amount)
    (set! balance (+ balance amount))
    balance)
  (define (dispatch m)
    (if (eq? m 'withdraw) withdraw
    (if (eq? m 'deposit) deposit
    (if (eq? m 'balance) balance
        (error "unknown request" m)))))
  dispatch)
(define acc (make-account 100))
(define acc2 (make-account 10))
(print ((acc 'withdraw) 30))
(print ((acc 'deposit) 50))
(print ((acc 'withdraw) 500))
(print ((acc2 'deposit) 5))
(print (acc 'balance))

(define (make-queue) (cons '() '()))
(define (enqueue! q x)
  (define cell (cons x '()))
  (if (pair? (car q)) (set-cdr! (cdr q) cell) (set-car! q cell))
  (set-cdr! q cell))
(define (dequeue! q)
  (define x (car (car q)))
  (set-car! q (cdr (car q)))
  x)
(define q (make-queue))
(enqueue! q 'a)
(enqueue! q 'b)
(enqueue! q 'c)
(print (dequeue! q))
(enqueue! q 'd)
(print (car q))
(print (dequeue! q))
(print (dequeue! q))
(print (dequeue! q))
(enqueue! q 'e)
(print (car q))
