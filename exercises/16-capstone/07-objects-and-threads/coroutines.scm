(define ready '())
(define (append2 a b) (if (pair? a) (cons (car a) (append2 (cdr a) b)) b))
(define (enqueue! thunk) (set! ready (append2 ready (cons thunk '()))))
(define scheduler-exit #f)
(define (run-next)
  (if (pair? ready)
      ((lambda (t) (set! ready (cdr ready)) (t)) (car ready))
      (scheduler-exit 'all-done)))
(define (yield)
  (call/cc (lambda (k) (enqueue! (lambda () (k #f))) (run-next))))
(define (spawn proc) (enqueue! (lambda () (proc) (run-next))))
(define (worker name n)
  (lambda ()
    (define (loop i)
      (if (< i n)
          (begin (print (cons name i)) (yield) (loop (+ i 1)))))
    (loop 0)))
(spawn (worker 'a 3))
(spawn (worker 'b 2))
(spawn (worker 'c 1))
(print (call/cc (lambda (k) (set! scheduler-exit k) (run-next))))
