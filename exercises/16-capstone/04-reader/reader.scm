(define (char=? a b) (= (char->integer a) (char->integer b)))
(define (whitespace? c) (< (char->integer c) 33))
(define (delimiter? c)
  (if (eof-object? c) #t
      (if (whitespace? c) #t
          (if (char=? c #\() #t
              (if (char=? c #\)) #t
                  (char=? c #\;))))))
(define (skip-line)
  (define c (read-char))
  (if (eof-object? c) #f (if (char=? c #\newline) #f (skip-line))))
(define (skip-atmosphere)
  (define c (peek-char))
  (if (eof-object? c) #f
      (if (whitespace? c) (begin (read-char) (skip-atmosphere))
          (if (char=? c #\;) (begin (skip-line) (skip-atmosphere)) #f))))

(define dot (cons 'dot '()))

(define (read-datum)
  (skip-atmosphere)
  (read-datum-1 (peek-char)))
(define (read-datum-1 c)
  (if (eof-object? c) c
  (if (char=? c #\() (begin (read-char) (read-list-tail))
  (if (char=? c #\') (begin (read-char) (cons 'quote (cons (read-datum) '())))
      (parse-token (read-token))))))
(define (read-list-tail)
  (skip-atmosphere)
  (read-list-tail-1 (peek-char)))
(define (read-list-tail-1 c)
  (if (eof-object? c) (error "unexpected end of input")
      (if (char=? c #\)) (begin (read-char) '())
          (read-list-item (read-datum)))))
(define (read-list-item d)
  (if (eq? d dot)
      (finish-dotted (read-datum))
      (cons d (read-list-tail))))
(define (finish-dotted d)
  (skip-atmosphere)
  (read-char)
  d)

(define (read-token)
  (if (delimiter? (peek-char)) '() (read-token-from (read-char))))
(define (read-token-from c) (cons c (read-token)))

(define (digit? c) (if (< 47 (char->integer c)) (< (char->integer c) 58) #f))
(define (all-digits? cs)
  (if (pair? cs)
      (if (digit? (car cs)) (if (pair? (cdr cs)) (all-digits? (cdr cs)) #t) #f)
      #f))
(define (digits->integer cs acc)
  (if (pair? cs)
      (digits->integer (cdr cs) (+ (* acc 10) (- (char->integer (car cs)) 48)))
      acc))
(define (parse-token cs)
  (if (all-digits? cs) (digits->integer cs 0)
  (if (if (char=? (car cs) #\-) (all-digits? (cdr cs)) #f)
      (- 0 (digits->integer (cdr cs) 0))
  (if (if (char=? (car cs) #\#) (pair? (cdr cs)) #f)
      (char=? (car (cdr cs)) #\t)
  (if (if (char=? (car cs) #\.) (eq? (cdr cs) '()) #f)
      dot
      (string->symbol (list->string cs)))))))

(define (main)
  (define d (read-datum))
  (if (eof-object? d) 'done (begin (print d) (main))))
(main)
