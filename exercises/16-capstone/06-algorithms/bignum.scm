(define (head x) (if (pair? x) (car x) 0))
(define (tail x) (if (pair? x) (cdr x) '()))
;; Numbers are little-endian lists of decimal digits.
(define (big-add a b carry)
  (if (if (pair? a) #f (if (pair? b) #f #t))
      (if (= carry 0) '() (cons carry '()))
      (big-add-digit (+ (+ (head a) (head b)) carry) a b)))
(define (big-add-digit s a b)
  (cons (remainder s 10) (big-add (tail a) (tail b) (quotient s 10))))
(define (big-mul-small b n carry)
  (if (pair? b)
      (big-mul-digit (+ (* (car b) n) carry) b n)
      (if (= carry 0) '() (cons (remainder carry 10) (big-mul-small '() n (quotient carry 10))))))
(define (big-mul-digit p b n)
  (cons (remainder p 10) (big-mul-small (cdr b) n (quotient p 10))))
(define (big-fact n) (if (= n 0) (cons 1 '()) (big-mul-small (big-fact (- n 1)) n 0)))
(define (big-expt2 k) (if (= k 0) (cons 1 '()) (big-mul-small (big-expt2 (- k 1)) 2 0)))
(define (fib-iter n a b) (if (= n 0) a (fib-iter (- n 1) b (big-add a b 0))))
(define (big-fib n) (fib-iter n (cons 0 '()) (cons 1 '())))
(define (reverse l acc) (if (pair? l) (reverse (cdr l) (cons (car l) acc)) acc))
(define (write-digits ds)
  (if (pair? ds)
      (begin (write-char (integer->char (+ 48 (car ds)))) (write-digits (cdr ds)))))
(define (print-big b) (write-digits (reverse b '())) (write-char #\newline))
(print-big (big-fact 0))
(print-big (big-fact 30))
(print-big (big-expt2 100))
(print-big (big-fib 100))
