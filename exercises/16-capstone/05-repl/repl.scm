;; The evaluator from metacircular.scm plus the reader from reader.scm.

(define (list . xs) xs)
(define (cadr x) (car (cdr x)))
(define (cddr x) (cdr (cdr x)))
(define (caddr x) (car (cdr (cdr x))))
(define (cadddr x) (car (cdr (cdr (cdr x)))))
(define (assq k al)
  (if (pair? al) (if (eq? (car (car al)) k) (car al) (assq k (cdr al))) #f))

;; An environment is a list of frames; a frame is a box (a pair) holding an alist.
(define (make-bindings vars vals)
  (if (pair? vars)
      (cons (cons (car vars) (car vals)) (make-bindings (cdr vars) (cdr vals)))
      '()))
(define (extend vars vals env) (cons (cons (make-bindings vars vals) '()) env))
(define (lookup var env)
  (if (pair? env)
      (lookup-in (assq var (car (car env))) var env)
      (error "unbound variable" var)))
(define (lookup-in binding var env)
  (if binding (cdr binding) (lookup var (cdr env))))
(define (define-var! var val env)
  (set-car! (car env) (cons (cons var val) (car (car env))))
  var)

(define (m-eval x env)
  (if (symbol? x) (lookup x env)
  (if (pair? x)
      (if (eq? (car x) 'quote) (cadr x)
      (if (eq? (car x) 'if)
          (if (m-eval (cadr x) env) (m-eval (caddr x) env) (m-eval (cadddr x) env))
      (if (eq? (car x) 'lambda) (list 'closure (cadr x) (cddr x) env)
      (if (eq? (car x) 'define) (define-var! (cadr x) (m-eval (caddr x) env) env)
          (m-apply (m-eval (car x) env) (eval-list (cdr x) env))))))
      x)))
(define (eval-list xs env)
  (if (pair? xs) (cons (m-eval (car xs) env) (eval-list (cdr xs) env)) '()))
(define (eval-body body env)
  (if (pair? (cdr body))
      (begin (m-eval (car body) env) (eval-body (cdr body) env))
      (m-eval (car body) env)))
(define (m-apply f args)
  (if (procedure? f)
      (apply f args)
      (eval-body (caddr f) (extend (cadr f) args (cadddr f)))))

(define global
  (extend '(+ - * = < car cdr cons null?)
          (list + - * = < car cdr cons (lambda (x) (eq? x '())))
          '()))
(define (run x) (m-eval x global))


(define (char=? a b) (= (char->integer a) (char->integer b)))
(define (whitespace? c) (< (char->integer c) 33))
(define (delimiter? c)
  (if (eof-object? c) #t
      (if (whitespace? c) #t
          (if (char=? c #\() #t
              (if (char=? c #\)) #t
                  (char=? c #\;))))))
(define (skip-line)
  (define c (read-char))
  (if (eof-object? c) #f (if (char=? c #\newline) #f (skip-line))))
(define (skip-atmosphere)
  (define c (peek-char))
  (if (eof-object? c) #f
      (if (whitespace? c) (begin (read-char) (skip-atmosphere))
          (if (char=? c #\;) (begin (skip-line) (skip-atmosphere)) #f))))

(define dot (cons 'dot '()))

(define (read-datum)
  (skip-atmosphere)
  (read-datum-1 (peek-char)))
(define (read-datum-1 c)
  (if (eof-object? c) c
  (if (char=? c #\() (begin (read-char) (read-list-tail))
  (if (char=? c #\') (begin (read-char) (cons 'quote (cons (read-datum) '())))
      (parse-token (read-token))))))
(define (read-list-tail)
  (skip-atmosphere)
  (read-list-tail-1 (peek-char)))
(define (read-list-tail-1 c)
  (if (eof-object? c) (error "unexpected end of input")
      (if (char=? c #\)) (begin (read-char) '())
          (read-list-item (read-datum)))))
(define (read-list-item d)
  (if (eq? d dot)
      (finish-dotted (read-datum))
      (cons d (read-list-tail))))
(define (finish-dotted d)
  (skip-atmosphere)
  (read-char)
  d)

(define (read-token)
  (if (delimiter? (peek-char)) '() (read-token-from (read-char))))
(define (read-token-from c) (cons c (read-token)))

(define (digit? c) (if (< 47 (char->integer c)) (< (char->integer c) 58) #f))
(define (all-digits? cs)
  (if (pair? cs)
      (if (digit? (car cs)) (if (pair? (cdr cs)) (all-digits? (cdr cs)) #t) #f)
      #f))
(define (digits->integer cs acc)
  (if (pair? cs)
      (digits->integer (cdr cs) (+ (* acc 10) (- (char->integer (car cs)) 48)))
      acc))
(define (parse-token cs)
  (if (all-digits? cs) (digits->integer cs 0)
  (if (if (char=? (car cs) #\-) (all-digits? (cdr cs)) #f)
      (- 0 (digits->integer (cdr cs) 0))
  (if (if (char=? (car cs) #\#) (pair? (cdr cs)) #f)
      (char=? (car (cdr cs)) #\t)
  (if (if (char=? (car cs) #\.) (eq? (cdr cs) '()) #f)
      dot
      (string->symbol (list->string cs)))))))


(define (prompt) (write-chars (string->list "> ")))
(define (repl) (prompt) (repl-1 (read-datum)))
(define (repl-1 d)
  (if (eof-object? d)
      (write-char #\newline)
      (begin (print (run d)) (repl))))
(repl)
