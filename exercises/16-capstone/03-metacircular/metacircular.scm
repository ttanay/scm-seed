(define (list . xs) xs)
(define (cadr x) (car (cdr x)))
(define (cddr x) (cdr (cdr x)))
(define (caddr x) (car (cdr (cdr x))))
(define (cadddr x) (car (cdr (cdr (cdr x)))))
(define (assq k al)
  (if (pair? al) (if (eq? (car (car al)) k) (car al) (assq k (cdr al))) #f))

;; An environment is a list of frames; a frame is a box (a pair) holding an alist.
(define (make-bindings vars vals)
  (if (pair? vars)
      (cons (cons (car vars) (car vals)) (make-bindings (cdr vars) (cdr vals)))
      '()))
(define (extend vars vals env) (cons (cons (make-bindings vars vals) '()) env))
(define (lookup var env)
  (if (pair? env)
      (lookup-in (assq var (car (car env))) var env)
      (error "unbound variable" var)))
(define (lookup-in binding var env)
  (if binding (cdr binding) (lookup var (cdr env))))
(define (define-var! var val env)
  (set-car! (car env) (cons (cons var val) (car (car env))))
  var)

(define (m-eval x env)
  (if (symbol? x) (lookup x env)
  (if (pair? x)
      (if (eq? (car x) 'quote) (cadr x)
      (if (eq? (car x) 'if)
          (if (m-eval (cadr x) env) (m-eval (caddr x) env) (m-eval (cadddr x) env))
      (if (eq? (car x) 'lambda) (list 'closure (cadr x) (cddr x) env)
      (if (eq? (car x) 'define) (define-var! (cadr x) (m-eval (caddr x) env) env)
          (m-apply (m-eval (car x) env) (eval-list (cdr x) env))))))
      x)))
(define (eval-list xs env)
  (if (pair? xs) (cons (m-eval (car xs) env) (eval-list (cdr xs) env)) '()))
(define (eval-body body env)
  (if (pair? (cdr body))
      (begin (m-eval (car body) env) (eval-body (cdr body) env))
      (m-eval (car body) env)))
(define (m-apply f args)
  (if (procedure? f)
      (apply f args)
      (eval-body (caddr f) (extend (cadr f) args (cadddr f)))))

(define global
  (extend '(+ - * = < car cdr cons null?)
          (list + - * = < car cdr cons (lambda (x) (eq? x '())))
          '()))
(define (run x) (m-eval x global))

(run '(define fact (lambda (n) (if (= n 0) 1 (* n (fact (- n 1)))))))
(print (run '(fact 10)))
(run '(define make-adder (lambda (n) (lambda (x) (+ x n)))))
(print (run '((make-adder 3) 4)))
(run '(define map (lambda (f l) (if (null? l) (quote ()) (cons (f (car l)) (map f (cdr l)))))))
(print (run '(map (lambda (x) (* x x)) (quote (1 2 3 4)))))
(print (run '((lambda (x y) y) 1 2)))
(print (run '(map (make-adder 10) (map fact (quote (0 1 2 3 4 5))))))
